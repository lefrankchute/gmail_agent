# Database
DATABASE_URL=postgresql://gmail_agent:localdev@localhost:5432/gmail_agent

# Redis
REDIS_URL=redis://localhost:6379

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/auth/callback
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=fpabon10@gmail.com

# Claude API
ANTHROPIC_API_KEY=

# Notifications
NOTIFICATION_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange Rate API (https://exchangerate-api.com - free tier)
EXCHANGE_RATE_API_KEY=

# App
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=America/Bogota

# Resumen diario — elige UNO de los dos modos:
DAILY_SUMMARY_HOUR=7              # Modo cron: envía cada día a esta hora (0-23)
# DAILY_SUMMARY_INTERVAL_MIN=60  # Modo intervalo: envía cada N minutos (ej: 60 = cada hora)
                                  # Si DAILY_SUMMARY_INTERVAL_MIN está definido, ignora DAILY_SUMMARY_HOUR

FINANCIAL_PORT=3002

# Worker intervals (in minutes)
POLLING_INTERVAL_MIN=5
INBOX_ADVISOR_INTERVAL_MIN=10
LABEL_SCANNER_INTERVAL_MIN=15
LABEL_SYNC_INTERVAL_MIN=60
DOMAIN_POLICY_INTERVAL_HOURS=24
